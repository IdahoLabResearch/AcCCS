# General Settings
NETWORK_INTERFACE=acccs_secc
ENABLE_TLS_1_3=True
ENABLE_NMAP=False

# SECC Settings
FREE_CHARGING_SERVICE=False
FREE_CERT_INSTALL_SERVICE=True
ALLOW_CERT_INSTALL_SERVICE=True
USE_CPO_BACKEND=False
SECC_ENFORCE_TLS=False
PROTOCOLS=DIN_SPEC_70121,ISO_15118_2,ISO_15118_20_AC,ISO_15118_20_DC

# LOG Settings
CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG

# EVSE Properties
EVSEID=USFRDE8326

# NMAP Settings
NMAP_ARGS="-sS -sU -6"
NMAP_PORTS="-"

# Virtual Testing
VIRTUAL=True