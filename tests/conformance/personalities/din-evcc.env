# Bootstrap DIN 70121 EVCC test personality.
# Mirrors .env.evcc with DIN-only protocol selection.

NETWORK_INTERFACE=acccs_evcc
ENABLE_TLS_1_3=False
ENABLE_NMAP=False

EVCC_CONFIG_PATH=app/shared/examples/evcc/DIN/evcc_config.json

CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG

EVCCID=1FMVAA45B63C47DD58Y6

NMAP_ARGS="-sS -sU -6"
NMAP_PORTS="-"

VIRTUAL=True
