# Bootstrap ISO 15118-20 PnC DC TLS-on SECC test personality.
# Slice 1: placeholder; wiring deferred to personality Slice 4 (#9).

NETWORK_INTERFACE=acccs_secc
ENABLE_TLS_1_3=True
ENABLE_NMAP=False

FREE_CHARGING_SERVICE=False
FREE_CERT_INSTALL_SERVICE=True
ALLOW_CERT_INSTALL_SERVICE=True
USE_CPO_BACKEND=False
SECC_ENFORCE_TLS=True
PROTOCOLS=ISO_15118_20_DC

CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG

EVSEID=USFRDE8326

NMAP_ARGS="-sS -sU -6"
NMAP_PORTS="-"

VIRTUAL=True
