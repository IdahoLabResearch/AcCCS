# Bootstrap DIN 70121 SECC test personality.
# Mirrors .env.secc with DIN as the negotiated protocol.

NETWORK_INTERFACE=acccs_secc
ENABLE_TLS_1_3=False
ENABLE_NMAP=False

FREE_CHARGING_SERVICE=False
FREE_CERT_INSTALL_SERVICE=True
ALLOW_CERT_INSTALL_SERVICE=True
USE_CPO_BACKEND=False
SECC_ENFORCE_TLS=False
PROTOCOLS=DIN_SPEC_70121

CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG

EVSEID=49A89A6360

NMAP_ARGS="-sS -sU -6"
NMAP_PORTS="-"

VIRTUAL=True
