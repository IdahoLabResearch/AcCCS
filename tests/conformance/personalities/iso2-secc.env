# Bootstrap ISO 15118-2 PnC DC TLS-on SECC test personality.
# Slice 1 placeholder — see iso2-evcc.env.

NETWORK_INTERFACE=acccs_secc
ENABLE_TLS_1_3=True
ENABLE_NMAP=False

FREE_CHARGING_SERVICE=False
FREE_CERT_INSTALL_SERVICE=True
ALLOW_CERT_INSTALL_SERVICE=True
USE_CPO_BACKEND=False
SECC_ENFORCE_TLS=True
PROTOCOLS=ISO_15118_2

CONSOLE_LOG_LEVEL=INFO
FILE_LOG_LEVEL=DEBUG

EVSEID=USFRDE8326

NMAP_ARGS="-sS -sU -6"
NMAP_PORTS="-"

VIRTUAL=True
