# Ignore all zip files (probably a backup)
.vscode/
__pycache__/
logs/
scan_results/
app/shared/pki/iso15118_2
app/shared/pki/iso15118_20

*.zip
*test.py
*.pyc
*.lck

test_*

# The conformance suite (ADR-0003) intentionally tracks test_*.py files and
# conftest.py under tests/. The blanket test_* / *test.py rules above predate
# the suite and would otherwise swallow it.
!tests/**/test_*.py
!tests/**/conftest.py

PWM_PCB.kicad_prl
server_keylog.log
client_keylog.log

# Per-role emulator stdout from the replay-corpus capture script — scratch
# artefacts kept only for post-capture debugging. The replay corpus itself
# is the `.jsonl` + `.yaml` pair next to each `.log`.
tests/conformance/captures/**/*.evcc.log
tests/conformance/captures/**/*.secc.log